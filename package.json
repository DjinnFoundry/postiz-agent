{
  "name": "postiz-agent",
  "version": "0.1.0",
  "description": "Autonomous social publishing agent for AudioKids stories. Bridges AudioKids output to Postiz (X/TikTok/IG), YouTubeCLI, and Spotify RSS.",
  "type": "module",
  "private": true,
  "bin": {
    "postiz-agent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "publish-story": "tsx src/cli.ts publish",
    "fetch-fonts": "tsx scripts/fetch-fonts.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
